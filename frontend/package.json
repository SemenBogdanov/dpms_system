{
  "name": "dpms-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && npm run smoke:navigation && npm run smoke:mobile-readiness && npm run smoke:audit-calendar-access",
    "smoke:audit-calendar-access": "node scripts/check-audit-calendar-access.mjs",
    "test:audit-calendar": "npm run build && playwright test --config playwright.audit-calendar.config.ts",
    "smoke:navigation": "node scripts/check-navigation.mjs",
    "smoke:mobile-readiness": "node scripts/check-mobile-readiness.mjs",
    "test:mobile": "npm run build && playwright test --config playwright.mobile.config.ts",
    "test:ux-safety": "npm run build && playwright test --config playwright.ux-safety.config.ts",
    "preview": "vite preview",
    "test:realtime-notes": "npm run build && playwright test --config playwright.realtime-notes.config.ts",
    "test:messages": "playwright test --config playwright.messages.config.ts",
    "test:audit-review": "playwright test --config playwright.audit-review.config.ts",
    "test:audit-legacy": "playwright test --config playwright.audit-legacy.config.ts",
    "test:audit-legacy-transfer": "playwright test --config playwright.audit-legacy-transfer.config.ts",
    "test:audit-legacy-history": "vite build --outDir /tmp/dpms-a19-history-build && playwright test --config tests/audit-legacy-history.config.ts",
    "test:id64a": "playwright test --config playwright.id64a.config.ts",
    "test:trackers": "playwright test --config playwright.trackers.config.ts",
    "test:note-groups": "playwright test --config playwright.note-groups.config.ts",
    "test:personal-task-form": "npm run build && playwright test --config tests/personal-task-form.config.ts",
    "test:regression": "../scripts/dpms-local-regression.sh full",
    "test:regression:quick": "../scripts/dpms-local-regression.sh quick"
  },
  "dependencies": {
    "@fontsource-variable/victor-mono": "^5.2.8",
    "clsx": "^2.1.0",
    "lucide-react": "^0.323.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.18.1",
    "recharts": "^2.12.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.8"
  },
  "overrides": {
    "lodash": "4.18.1"
  }
}
